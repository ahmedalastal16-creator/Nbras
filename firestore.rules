rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidConversation(data, userId, conversationId) {
      return data.userId is string && data.userId == userId &&
             data.stageId is string && data.stageId.size() >= 1 && data.stageId.size() <= 64 &&
             data.stageId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.stageTitle is string && data.stageTitle.size() >= 1 && data.stageTitle.size() <= 120 &&
             data.subjectTitle is string && data.subjectTitle.size() >= 1 && data.subjectTitle.size() <= 120 &&
             data.lastMessagePreview is string && data.lastMessagePreview.size() <= 300 &&
             data.messageCount is int && data.messageCount >= 0 && data.messageCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time &&
             isValidId(conversationId);
    }

    function isValidChatMessage(data, userId, conversationId) {
      return data.userId is string && data.userId == userId &&
             data.conversationId is string && data.conversationId == conversationId &&
             data.role is string && (data.role == 'user' || data.role == 'model') &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 20000 &&
             (!('imageUri' in data) || (data.imageUri is string && data.imageUri.size() <= 1000)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- User-Scoped Package Conversations ---
    match /users/{userId}/conversations/{conversationId} {
      allow get: if isOwner(userId) && isValidId(conversationId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       incoming().keys().hasAll([
                         'userId', 'stageId', 'stageTitle', 'subjectTitle',
                         'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'stageId', 'stageTitle', 'subjectTitle',
                         'lastMessagePreview', 'messageCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidConversation(incoming(), userId, conversationId);

      allow update: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming(), userId, conversationId) &&
                       incoming().userId == existing().userId &&
                       incoming().stageId == existing().stageId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'stageTitle', 'subjectTitle', 'lastMessagePreview', 'messageCount', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(conversationId);

      // --- Messages Subcollection per Package Conversation ---
      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(conversationId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'conversationId', 'role', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'conversationId', 'role', 'text', 'imageUri', 'createdAt']) &&
                         isValidChatMessage(incoming(), userId, conversationId) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/conversations/$(conversationId));

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
      }
    }

    // --- Validation Blueprint & Rules for Cloud Study Summaries ---
    function isValidStudySummary(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.stageId is string && data.stageId.size() >= 1 && data.stageId.size() <= 64 &&
             data.stageId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.stageTitle is string && data.stageTitle.size() >= 1 && data.stageTitle.size() <= 120 &&
             data.subjectTitle is string && data.subjectTitle.size() >= 1 && data.subjectTitle.size() <= 120 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 25000 &&
             data.keyTerms is string && data.keyTerms.size() <= 500 &&
             data.sourceType is string && (data.sourceType == 'manual' || data.sourceType == 'ai_lab' || data.sourceType == 'tutor') &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId}/summaries/{summaryId} {
      allow get: if isOwner(userId) && isValidId(summaryId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(summaryId) &&
                       incoming().keys().hasAll([
                         'userId', 'stageId', 'stageTitle', 'subjectTitle',
                         'title', 'content', 'keyTerms', 'sourceType',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'stageId', 'stageTitle', 'subjectTitle',
                         'title', 'content', 'keyTerms', 'sourceType',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidStudySummary(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(summaryId) &&
                       isValidStudySummary(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().sourceType == existing().sourceType &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'stageId', 'stageTitle', 'subjectTitle',
                         'title', 'content', 'keyTerms', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(summaryId);
    }
  }
}
